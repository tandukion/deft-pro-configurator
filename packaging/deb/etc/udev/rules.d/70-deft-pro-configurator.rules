# Elecom DEFT Pro: grant the active desktop user access to the input device.
# Known DEFT Pro USB product IDs include 0131 and 0132.
ACTION=="add", SUBSYSTEM=="input", ATTRS{idVendor}=="056e", ATTRS{idProduct}=="0131|0132", TAG+="uaccess"
# Allow the active desktop user to create/manage a uinput virtual pointer.
KERNEL=="uinput", MODE="0660", TAG+="uaccess"
